diff --git a/models/stage_transformer.py b/models/stage_transformer.py
index 8bed665..32d1393 100644
--- a/models/stage_transformer.py
+++ b/models/stage_transformer.py
@@ -38,6 +38,54 @@ def build_model():
     return model
 
 
+VGGFACE2_PKL = '/path/to/checkpoints/resnet50_ft_weight.pkl'
+
+
+class _StageInputToVGGFace2(nn.Module):
+    """STAGE feeds frames normalized to [-1, 1] (x*2/255 - 1, RGB).
+    VGGFace2 weights expect BGR / 0-255 / mean-subtracted input."""
+
+    def __init__(self):
+        super().__init__()
+        self.register_buffer('vgg_mean',
+                             torch.tensor([91.4953, 103.8827, 131.0912]).view(1, 3, 1, 1))
+
+    def forward(self, x):
+        x = (x + 1.0) * 127.5          # [-1,1] -> RGB 0-255
+        x = x.flip(dims=[1])           # RGB -> BGR
+        return x - self.vgg_mean
+
+
+def build_model_vggface2():
+    """Same-backbone control (rebuttal): VGGFace2 ResNet-50 truncated at layer3,
+    projected 1024->256 so the SAM modules see the identical feature shape
+    (256ch, 8x8 for 128x128 input) as the original GazeCLR ResNet-18."""
+    import pickle
+    cnn = torchvision.models.resnet50(weights=None)
+    with open(VGGFACE2_PKL, 'rb') as f:
+        raw = pickle.load(f, encoding='latin1')
+    own = cnn.state_dict()
+    n_loaded = 0
+    for k, v in raw.items():
+        if k.startswith('fc.'):
+            continue
+        t = torch.from_numpy(v) if not isinstance(v, torch.Tensor) else v
+        if k in own and own[k].shape == t.shape:
+            own[k] = t
+            n_loaded += 1
+    cnn.load_state_dict(own, strict=False)
+    print(f'*******Loaded VGGFace2 R50 backbone ({n_loaded} tensors)********')
+
+    proj = nn.Conv2d(1024, 256, kernel_size=1, bias=False)  # match SAM input (256, 8, 8)
+    layers = [
+        _StageInputToVGGFace2(),
+        cnn.conv1, cnn.bn1, cnn.relu, cnn.maxpool,
+        cnn.layer1, cnn.layer2, cnn.layer3,
+        proj,
+    ]
+    return torch.nn.Sequential(*layers)
+
+
 class STAGE_Transformer(nn.Module):
 
     def __init__(self, config):
